digraph G { graph [rankdir=TB,bgcolor="white",fontname="Noto Sans CJK SC",nodesep=.34,ranksep=.43,labelloc=t,label="数智化转型后：系统 + AI 辅助决策目标流程",fontsize=19]; node [shape=box,style="rounded,filled",fillcolor="#eef5ff",color="#9db6e0",fontname="Noto Sans CJK SC",fontsize=12,margin="0.18,0.11"]; edge [color="#6b85b0",fontname="Noto Sans CJK SC"]; start [label="用户进入统一管理平台",shape=oval,fillcolor="#dce9ff"]; a [label="填写预约需求 / 用途 / 人数 / 日期"]; b [label="系统查询实时台账与冲突状态"]; c [label="AI/规则辅助推荐合适实验室\n输出推荐理由（MVP仅实现规则）",fillcolor="#e5dfff"]; d [label="管理员人工确认预约与风险",fillcolor="#fff1d6"]; e [label="审批通过？",shape=diamond,fillcolor="#fff1d6"]; f [label="系统提示调整方案"]; g [label="系统记录审批 / 通知 / 留痕"]; h [label="实验室使用与在线巡检"]; i [label="异常描述输入 + AI/规则辅助预警\n（MVP 为关键词提示）",fillcolor="#e5dfff"]; j [label="安全管理员核验分级、下发整改"]; k [label="整改反馈 / 复核 / 关闭隐患"]; end [label="汇总统计与可追溯台账",shape=oval,fillcolor="#ddf6e9"]; start->a->b->c->d->e;e->f[label="否"];f->a;e->g[label="是"];g->h->i->j->k->end; }