digraph G { graph [rankdir=TB,bgcolor="white",fontname="Noto Sans CJK SC",nodesep=.35,ranksep=.42,labelloc=t,label="现状：人工实验室预约与巡检流程（无 AI）",fontsize=19]; node [shape=box,style="rounded,filled",fillcolor="#f2f5fa",color="#a8b9d5",fontname="Noto Sans CJK SC",fontsize=12,margin="0.18,0.12"]; edge [color="#7185a9",fontname="Noto Sans CJK SC"]; start [label="教师/学生提出实验室使用需求",shape=oval,fillcolor="#dce9ff"]; a [label="联系管理员 / 填写纸质或群内表单"]; b [label="管理员人工查阅台账及课表"]; c [label="实验室与时间是否冲突？",shape=diamond,fillcolor="#fff1d6"]; d [label="人工沟通更换时间 / 场地",fillcolor="#ffe2e3"]; e [label="管理员人工审批、通知申请人"]; f [label="到场使用并纸质登记"]; g [label="管理员定期巡检 / 发现异常"]; h [label="微信/电话上报，纸质记录"]; i [label="人工安排整改并回访"]; end [label="归档分散表格 / 结束",shape=oval,fillcolor="#ddf6e9"]; start->a->b->c;c->d[label="是"];d->b;c->e[label="否"];e->f->g->h->i->end; }